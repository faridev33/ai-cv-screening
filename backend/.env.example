# Salin berkas ini menjadi backend/.env lalu isi nilainya.
#   PowerShell : Copy-Item backend\.env.example backend\.env
#   bash       : cp backend/.env.example backend/.env
#
# Jangan pernah commit berkas .env (sudah ada di .gitignore).

# Kunci API OpenRouter — wajib untuk semua fitur AI.
# Buat di https://openrouter.ai/keys
MY_API_KEY=sk-or-v1-isi-kunci-openrouter-anda

# Model default bila request tidak mengirim field "model".
# Format wajib vendor/nama-model, mis. qwen/qwen3.8-max
MODEL_NAME=qwen/qwen3.8-max